  "styles": {
    "color": {
      "background": "var(--color-background)",
      "text": "var(--color-foreground)"
    },
    "typography": {
      "fontFamily": "var(--font-body)",
      "fontSize": "var(--text-body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--font-display)",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "var(--color-link)"
        }
      }
    }
